rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasAnyRole(roles) { return signedIn() && request.auth.token.role in roles; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isSelf(userId) || hasAnyRole(['super_admin', 'admin', 'support']);
      allow create, update, delete: if false;
    }
    match /boards/{id} { allow read: if signedIn(); allow write: if false; }
    match /classes/{id} { allow read: if signedIn(); allow write: if false; }
    match /subjects/{id} { allow read: if signedIn(); allow write: if false; }
    match /chapters/{id} { allow read: if signedIn(); allow write: if false; }
    match /topics/{id} { allow read: if signedIn(); allow write: if false; }
    match /skillCategories/{id} { allow read: if signedIn(); allow write: if false; }
    match /skills/{id} { allow read: if signedIn(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}